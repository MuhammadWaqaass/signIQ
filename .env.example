# Redis: use your Upstash URL (starts with rediss://) or any Redis you have.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR-HOST.upstash.io:6379

# Where uploads and crops are saved while developing (local folder).
DATA_DIR=./data

# SQLite by default. Later: your Supabase Postgres connection string.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/postgres

# Frontend origins allowed to call the API (comma separated). Lock this down in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Detector. Option A: a local file you already have.
DETECTOR_LOCAL_PATH=./weights/best.pt
# Option B (later): download from the Hugging Face Hub. Placeholder names, replace them.
DETECTOR_REPO=YOUR_USERNAME/signature-detector
DETECTOR_FILENAME=best.pt

# Similarity model (your repo, already deployed on the Hub).
SIMILARITY_REPO=izamscientist/signature-similarity-convnext-tiny

DETECT_CONF=0.385
DETECT_IOU=0.5

# ONNX model repository on Hugging Face Hub (set to your own repo after running upload_to_hf.py).
ONNX_REPO_ID=YOUR_USERNAME/signiq-onnx-models
DETECTOR_ONNX_FILENAME=best.onnx
SIMILARITY_ONNX_FILENAME=similarity.onnx
SIMILARITY_DATA_FILENAME=similarity.onnx.data

# Only needed if the ONNX repo is private (not required for public repos).
# HF_TOKEN=hf_xxx
